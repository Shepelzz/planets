  "pending": [
    {
      "what": "Марс: факт 1",
      "key": "080d85d7",
      "chars": 52,
      "text": "Марс червоний, бо його пісок і каміння вкриті іржею."
    },
    {
      "what": "Марс: факт 2",
      "key": "34e5ce1f",
      "chars": 97,
      "text": "На Марсі є найвища гора в Сонячній системі — вулкан Олімп. Він майже в 2,5 раза вищий за Еверест."
    },
    {
      "what": "Марс: факт 3",
      "key": "20ef983a",
      "chars": 59,
      "text": "Марсом їздять роботи-марсоходи й надсилають нам фотографії."
    },
    {
      "what": "Марс: факт 4",
      "key": "cb20d74c",
      "chars": 58,
      "text": "Захід сонця на Марсі блакитний, а вдень небо там рудувате."
    },
    {
      "what": "Марс: факт 5",
      "key": "0d40afee",
      "chars": 70,
      "text": "Доба на Марсі майже така сама, як на Землі, — лише на 37 хвилин довша."
    },
    {
      "what": "Юпітер: факт 1",
      "key": "caa2f36b",
      "chars": 67,
      "text": "Усередину Юпітера помістилося б понад 1 300 таких планет, як Земля."
    },
    {
      "what": "Юпітер: факт 2",
      "key": "3bf1597b",
      "chars": 86,
      "text": "Велика Червона Пляма — це ураган, більший за всю Землю. Він крутиться вже сотні років!"
    },
    {
      "what": "Юпітер: факт 3",
      "key": "32056138",
      "chars": 83,
      "text": "У Юпітера немає твердої поверхні — він складається з газу, на нього не можна стати."
    },
    {
      "what": "Юпітер: факт 4",
      "key": "c30ad2c9",
      "chars": 70,
      "text": "Юпітер крутиться швидше за всі планети: доба там триває лише 10 годин."
    },
    {
      "what": "Юпітер: факт 5",
      "key": "32637863",
      "chars": 70,
      "text": "У Юпітера теж є кільця, тільки дуже тонкі й темні — їх майже не видно."
    },
    {
      "what": "Сатурн: факт 1",
      "key": "d57095cb",
      "chars": 98,
      "text": "Кільця Сатурна складаються з мільярдів шматочків льоду й каміння — від піщинки до розміру будинку."
    },
    {
      "what": "Сатурн: факт 2",
      "key": "92677da1",
      "chars": 80,
      "text": "Сатурн такий легкий, що міг би плавати у величезній-превеличезній ванні з водою."
    },
    {
      "what": "Сатурн: факт 3",
      "key": "96f6fd93",
      "chars": 50,
      "text": "У Сатурна найбільше супутників у Сонячній системі."
    },
    {
      "what": "Сатурн: факт 4",
      "key": "d2debe68",
      "chars": 76,
      "text": "Кільця величезні завширшки, але дуже тонкі — місцями лише близько 10 метрів."
    },
    {
      "what": "Сатурн: факт 5",
      "key": "a65cb856",
      "chars": 87,
      "text": "На найбільшому супутнику Сатурна, Титані, є озера — тільки не з води, а з рідкого газу."
    },
    {
      "what": "Уран: факт 1",
      "key": "a684c05c",
      "chars": 75,
      "text": "Уран обертається, лежачи на боці, — ніби котиться своєю орбітою, як м’ячик."
    },
    {
      "what": "Уран: факт 2",
      "key": "53c0b97e",
      "chars": 49,
      "text": "В Урана найхолодніша атмосфера серед усіх планет."
    },
    {
      "what": "Уран: факт 3",
      "key": "7bdc8fe9",
      "chars": 32,
      "text": "Блакитним Уран робить газ метан."
    },
    {
      "what": "Уран: факт 4",
      "key": "1271d706",
      "chars": 78,
      "text": "На полюсі Урана Сонце не заходить 42 роки поспіль, а потім 42 роки триває ніч!"
    },
    {
      "what": "Уран: факт 5",
      "key": "5874d38e",
      "chars": 79,
      "text": "Супутники Урана назвали на честь героїв казок і п’єс: Титанія, Оберон, Міранда."
    },
    {
      "what": "Нептун: факт 1",
      "key": "594f99e9",
      "chars": 81,
      "text": "На Нептуні дмуть найсильніші вітри в Сонячній системі — понад 2 000 км на годину!"
    },
    {
      "what": "Нептун: факт 2",
      "key": "87d7cca4",
      "chars": 109,
      "text": "Нептун спочатку знайшли на папері: учені обчислили, де він має бути, і тільки потім побачили його в телескоп."
    },
    {
      "what": "Нептун: факт 3",
      "key": "ad6591b5",
      "chars": 72,
      "text": "Відтоді як Нептун відкрили у 1846 році, він облетів Сонце лише один раз."
    },
    {
      "what": "Нептун: факт 4",
      "key": "d54e65c7",
      "chars": 62,
      "text": "Світлу Сонця потрібно понад 4 години, щоб долетіти до Нептуна."
    }
  ]
}
